# Copy to .env (start.sh creates it for you from hardware detection).

# Ollama model that plans tests, drives the browser and explains failures.
OLLAMA_MODEL=qwen3-vl:4b-instruct
# Optional vision model: failure screenshots are sent to it for analysis (empty = text-only).
VISION_MODEL=
# Pull missing models automatically on startup / when changed in Settings.
OLLAMA_AUTO_PULL=true

# Agent budget
MAX_TESTS=4
MAX_STEPS_PER_TEST=8

# Ports on the host
APP_PORT=8080
OLLAMA_HOST_PORT=11434

# Filled in by start.sh (shown on the Settings tab)
HW_SUMMARY=
USE_GPU=false
MODEL_REASON=
